{
  "tasks": {
    "start": "deno run -A src/index.ts",
    "build": "deno install --alow-scripts",
    "clean": "rm -rf target",
    "restart": "deno build && deno start",
    "pushGuild": "deno run -A src/commands.ts",
    "pushGlobal": "deno run -A src/commands.ts --global"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "allowScripts": ["npm:@discordjs/opus@0.9.0", "npm:@distube/yt-dlp@2.0.1", "npm:fibers@5.0.3"]
}
